# Cubism/Adobe temporary and backup files
*.autosave
*.bak
*.tmp
~$*

# Official/reference assets stay local unless redistribution is confirmed.
reference/*
!reference/README.md

# Generated QA captures are replaceable.
qa/*.png

# Local dependency/download caches.
.uv-cache/
.uv-python/
.venv-codex/
logs/*.log
logs/*.csv
tools/see-through/.venv/

# Proprietary/downloaded Live2D runtime copied by viewer/setup-runtime.ps1.
viewer/vendor/
vrm-viewer/vendor/
viewer/__pycache__/
scripts/__pycache__/
tests/__pycache__/
pipeline/__pycache__/
pipeline/fixedtopo/__pycache__/
pipeline/keyform/__pycache__/
pipeline/sandbox/__pycache__/
work/qa/
work/sandbox/
work/keyform/
temp/

# Local Claude Code state and isolated worktrees.
.claude/

# Bridge experiment CMO3。マスターと `scripts/cubism_bridge` から再生成できるため、
# 生成条件を記録した `*.cmo3.agent.txt` だけを残す。
work/cubism/*-test.cmo3
work/cubism/*-attempt.cmo3
!work/cubism/mugi-normalized-rig-test.cmo3
